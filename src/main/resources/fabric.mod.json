{
  "schemaVersion": 1,
  "id": "sliding-mod",
  "version": "${version}",
  "name": "sliding-mod",
  "description": "A smooth sliding and jump boost mod with natural 1st and 3rd person motions",
  "authors": [
    "Me!"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/sliding-mod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.ExampleMod"
    ],
    "client": [
      "com.example.client.ExampleModClient"
    ]
  },
  "mixins": [
    "sliding-mod.mixins.json",
    {
      "config": "sliding-mod.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.14.21",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}